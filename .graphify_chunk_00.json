    {
      "id": "auto_login_flow",
      "label": "Auto-Login Flow Pattern",
      "file_type": "rationale",
      "source_file": "copilot/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "LoginFragment checks SessionManager.isLoggedIn() on onViewCreated. If logged in, request location immediately and navigate to map after 100ms delay. If not logged in, show OTP login UI. On successful login, save session and request location before navigation."
    },
    {
      "id": "otp_auth_flow",
      "label": "OTP Authentication Flow",
      "file_type": "rationale",
      "source_file": "copilot/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Two-step mobile OTP-based authentication: Step 1 - User enters 10-digit mobile number, frontend validates, calls sendOtp endpoint; Step 2 - Backend sends OTP, user receives and enters 6-digit OTP, frontend calls verifyOtp endpoint, backend returns JWT token and user info. SessionManager stores token for subsequent requests."
    },
    {
      "id": "gps_tracking_flow",
      "label": "GPS Tracking Flow",
      "file_type": "rationale",
      "source_file": "README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "After login, MainActivity.requestLocationAndStartTracking() checks permission and starts GpsTrackerService. Service runs FusedLocationProviderClient.requestLocationUpdates() every 10 seconds. Each location triggers LocationPing POST to /api/gps/ping. Backend checks 80m geofence around each station, updates crowd level based on active user count within geofence."
    },
    {
      "id": "single_activity_navigation",
      "label": "Single-Activity Navigation Pattern",
      "file_type": "rationale",
      "source_file": "copilot/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "MainActivity hosts NavHostFragment that switches between 5 screens (Login, Register, Map, List, Detail) via Jetpack Navigation. Bottom nav visibility controlled by destination listener - hidden for login/register, visible for other screens. All navigation defined in nav_graph.xml."
    },
    {
      "id": "retrofit_jwt_interceptor",
      "label": "Retrofit JWT Interceptor Pattern",
      "file_type": "rationale",
      "source_file": "copilot/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "RetrofitClient implements OkHttp interceptor that automatically injects JWT Bearer token into Authorization header for all API requests. Token retrieved from SessionManager.getToken(). If token null, request proceeds without auth header (for unauthenticated endpoints like sendOtp)."
    },
    {
      "id": "auto_refresh_pattern",
      "label": "Auto-Refresh Coroutine Pattern",
      "file_type": "rationale",
      "source_file": "copilot/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "StationDetailFragment uses Job in onResume() that loops with 15s delay calling loadCrowdStatus(). Job cancelled in onPause(). Checks isActive inside loop. Uses lifecycleScope so cancellation happens on Fragment destroy."
    },
    {
      "id": "view_binding_pattern",
      "label": "ViewBinding Pattern",
      "file_type": "rationale",
      "source_file": "copilot/AGENTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All fragments use private var _binding and getter that returns _binding!!. onCreateView() inflates and stores binding, onDestroyView() sets _binding = null. Provides type-safe view access without findViewById."
    }
  ],
