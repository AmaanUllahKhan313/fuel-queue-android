    {
      "id": "auto_login_implementation",
      "label": "Auto-Login Feature Implementation",
      "file_type": "rationale",
      "source_file": "copilot/IMPLEMENTATION_COMPLETE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Skip redundant login and permission dialogs on app restart for returning users. First-time users see full OTP+permission flow; returning users with valid session and granted permission skip to map instantly (0.5s vs 2-3s). GPS tracking starts during navigation instead of after map load."
    },
